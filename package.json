{
  "name": "custom-copilot-chat",
  "displayName": "Custom Copilot Chat",
  "description": "Add custom AI models to GitHub Copilot Chat model picker - OpenAI, Claude, Ollama, and any OpenAI-compatible API",
  "version": "1.1.7",
  "publisher": "custom-copilot",
  "repository": "https://github.com/ksk2023/custom_model_for_github_copliot",
  "engines": {
    "vscode": "^1.116.0"
  },
  "extensionDependencies": [
    "github.copilot-chat"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "copilot",
    "github-copilot",
    "chat",
    "ai",
    "openai",
    "claude",
    "ollama",
    "custom-model",
    "api"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "customai",
        "displayName": "Custom AI"
      }
    ],
    "chatParticipants": [
      {
        "id": "customai.setup",
        "name": "CustomAI",
        "description": "Add or manage custom AI models"
      }
    ],
    "commands": [
      {
        "command": "customai.openConfig",
        "title": "Open Custom AI Settings"
      },
      {
        "command": "customai.addModel",
        "title": "Add Custom Model"
      },
      {
        "command": "customai.addModelQuick",
        "title": "Quick Add Custom Model"
      }
    ],
    "configuration": {
      "title": "Custom Copilot Chat",
      "properties": {
        "customai.models": {
          "type": "array",
          "default": [],
          "description": "Custom AI models (each model belongs to a provider)"
        },
        "customai.providers": {
          "type": "array",
          "default": [],
          "description": "Custom AI providers (API endpoints with baseUrl and apiKey)"
        },
        "customai.defaultTemperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Default temperature for model responses"
        },
        "customai.defaultMaxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Default max tokens for model responses"
        },
        "customai.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && vsce package --pre-release --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
