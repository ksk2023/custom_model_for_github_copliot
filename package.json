{
  "name": "custom-copilot-chat",
  "displayName": "Custom Copilot Chat",
  "description": "Add custom AI models to GitHub Copilot Chat model picker - OpenAI, Claude, Ollama, and any OpenAI-compatible API",
  "version": "1.0.0",
  "publisher": "custom-copilot",
  "engines": {
    "vscode": "^1.116.0"
  },
  "extensionDependencies": [
    "github.copilot-chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "copilot",
    "github-copilot",
    "chat",
    "ai",
    "openai",
    "claude",
    "ollama",
    "custom-model",
    "api"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "customai",
        "displayName": "Custom AI"
      }
    ],
    "commands": [
      {
        "command": "customai.openConfig",
        "title": "Open Custom AI Settings"
      },
      {
        "command": "customai.addModel",
        "title": "Add Custom Model"
      },
      {
        "command": "customai.setApiKey",
        "title": "Set API Key for Model"
      }
    ],
    "configuration": {
      "title": "Custom Copilot Chat",
      "properties": {
        "customai.models": {
          "type": "array",
          "default": [],
          "description": "Custom AI models configuration"
        },
        "customai.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && vsce package --pre-release --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
